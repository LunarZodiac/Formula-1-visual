# Copy this file to .env.database.local and fill in your local password.
# .env.database.local is ignored by Git.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=f1_atlas
PGUSER=postgres
PGPASSWORD=replace_with_your_local_password

# Optional hosted environments. Keep real values in ignored .env files or in
# the Supabase/Vercel dashboards, never in Git.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_your_publishable_key
SUPABASE_DATABASE_URL=postgresql://postgres:password@host:5432/postgres
